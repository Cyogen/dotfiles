[
{
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "margin-bottom": 0,
    "modules-left": [
        "custom/logo",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/spotify",
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "bluetooth",
        "tray",
        "custom/ident",
        "custom/power"
    ],
    "custom/logo": {
        "format": "  ",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "persistent-workspaces": {
            "DP-1": [1, 2, 3, 4, 5]
        }
    },
    "clock": {
        "format": "  {:%H:%M  //  Exhahe  //  %a %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 1
    },
    "custom/ident": {
        "format": "Exhahe",
        "tooltip": false
    },
    "cpu": {
        "format": "󰻠  {usage}%",
        "tooltip": true,
        "interval": 2,
        "on-click": "kitty --title btop btop"
    },
    "memory": {
        "format": "󰍛  {used:0.1f}G",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G",
        "interval": 5,
        "on-click": "kitty --title btop btop"
    },
    "network": {
        "interval": 5,
        "format-ethernet": "󰛳  󰇚 {bandwidthDownBytes}  󰕒 {bandwidthUpBytes}",
        "format-wifi": "  {essid} ({signalStrength}%)",
        "format-disconnected": "󰌙  Offline",
        "format-linked": "  No IP",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\n Down: {bandwidthDownBytes}  Up: {bandwidthUpBytes}",
        "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}\nDown: {bandwidthDownBytes}  Up: {bandwidthUpBytes}"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  Muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%",
        "tooltip-format": "{desc}\nVolume: {volume}%"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 8
    },
    "custom/spotify": {
        "exec": "~/.config/waybar/scripts/spotify.sh",
        "return-type": "json",
        "interval": 1,
        "format": "{}",
        "on-click": "playerctl -p spotify play-pause",
        "on-scroll-up": "playerctl -p spotify next",
        "on-scroll-down": "playerctl -p spotify previous",
        "escape": true
    },
    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱  {device_alias}",
        "format-connected-battery": "󰂱  {device_alias}  {device_battery_percentage}%",
        "format-off": "󰂲",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "  {device_alias}",
        "on-click": "kitty --title bluetooth bluetui"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout"
    }
},
